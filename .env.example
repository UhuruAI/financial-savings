# Environment Variables Template
# Copy this file to .env and fill in your actual values

# App Environment
# Options: development, staging, production
NODE_ENV=development
EXPO_PUBLIC_ENVIRONMENT=development

# API Configuration
# Development API URL (default: http://localhost:3000/api)
EXPO_PUBLIC_API_URL_DEV=http://localhost:3000/api

# Staging API URL
EXPO_PUBLIC_API_URL_STAGING=https://staging-api.finsave.com/api

# Production API URL
EXPO_PUBLIC_API_URL_PROD=https://api.finsave.com/api

# Mock Data Configuration
# Set to 'true' to use mock data instead of real API calls (useful for development/testing)
# Default: true in development, false in production
EXPO_PUBLIC_USE_MOCK_DATA=true

# Authentication
EXPO_PUBLIC_JWT_SECRET=your-jwt-secret-here
EXPO_PUBLIC_REFRESH_TOKEN_EXPIRY=7d
EXPO_PUBLIC_ACCESS_TOKEN_EXPIRY=15m

# Third-Party Services
# Supabase (if using)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase (if using)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Payment Providers
# Stripe
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Plaid (Banking)
EXPO_PUBLIC_PLAID_ENV=sandbox
EXPO_PUBLIC_PLAID_PUBLIC_KEY=your-plaid-public-key
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret

# Sentry (Error Tracking)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token

# Analytics
EXPO_PUBLIC_ANALYTICS_ID=your-analytics-id

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRIC=true
EXPO_PUBLIC_ENABLE_INVESTMENTS=true
EXPO_PUBLIC_ENABLE_CRYPTO=false
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=true

# App Store / Play Store
EXPO_PUBLIC_IOS_APP_ID=id123456789
EXPO_PUBLIC_ANDROID_PACKAGE=com.yourcompany.financialsavings

# Support & Legal
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourapp.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://yourapp.com/privacy
EXPO_PUBLIC_TERMS_URL=https://yourapp.com/terms

# Development
EXPO_PUBLIC_DEBUG_MODE=true
